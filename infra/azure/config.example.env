# Copy to infra/azure/config.env and fill in. config.env is not committed.

# Who gets alert emails (server down, disk filling up, backup missing)
# and Let's Encrypt certificate notices.
ALERT_EMAIL=you@example.com

# Optional: an Azure subscription name or ID, if you have more than one.
AZURE_SUBSCRIPTION=

# Optional: your office's public IP as a range (e.g. 196.25.1.10/32) to allow
# SSH. Leave empty for no SSH from the internet (setup doesn't need it).
SSH_SOURCE_CIDR=

# Optional: add Azure Bastion for browser-based SSH (about US$140/month).
DEPLOY_BASTION=false

# Only when an app login (service principal) deploys, e.g. Codex or CI, and it
# isn't allowed to look itself up in the directory: its object ID.
DEPLOYER_OBJECT_ID=
